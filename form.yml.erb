---
# The `.erb` suffix is load-bearing: the dashboard renders this file through ERB
# only when the name ends in `.erb` (`BatchConnect::App#read_yaml_erb`). Named
# plain `form.yml`, every ERB tag below survives into the YAML as literal text —
# `cluster` then holds a string no cluster is named after, and the app refuses to
# open with "This app requires clusters that do not exist or you do not have
# access to."
#
# The cluster list is built from whatever OnDemand has configured in
# /etc/ood/config/clusters.d rather than hard-coded, so this app does not have to
# know the site's cluster id. If your site has exactly one cluster and you would
# rather not show the menu, delete `cluster` from the `form:` list below and add
# a top-level `cluster: "<your-cluster-id>"` key instead.
cluster:
  <%- OodAppkit.clusters.select(&:job_allow?).sort_by(&:id).each do |c| -%>
  - "<%= c.id %>"
  <%- end -%>
<%-
  # Default for `login_host` below, read from OnDemand's own cluster config
  # (`v2.login.host` in /etc/ood/config/clusters.d/<id>.yml) instead of naming a
  # site here. Same source the portal's Shell Access app uses.
  #
  # Fail-safe on purpose. A form that raises while rendering takes the whole
  # app down with it, and this is only the default for one editable text field —
  # so no clusters, no login section, or an OodAppkit that does not expose it all
  # degrade to blank rather than to a broken form. Blank is handled: the session
  # card then shows a direct ssh to the compute node, with a note about adding
  # -J yourself.
  #
  # Multi-cluster sites: this takes the first job-allowed cluster, and the form
  # renders once, so the default cannot follow the cluster menu. It stays
  # editable per session; a site that wants it to track the selection can drive
  # it from OnDemand's `data-set-*` option attributes.
  biopb_login_host = begin
    c = OodAppkit.clusters.select(&:job_allow?).sort_by(&:id).first
    (c && c.login && c.login.host).to_s
  rescue StandardError
    ""
  end
-%>

attributes:
  user_data_dir:
    label: "Data directory"
    widget: "path_selector"
    directory: "<%= CurrentUser.home %>"
    show_files: false
    help: |
      The folder BioPB will index and serve. Everything under it is scanned
      recursively. Point it at the parent of your image folders — no staging,
      conversion or import step is needed; files stay in their original format.

  bc_num_hours:
    label: "Hours"
    value: "4"
    min: 1
    max: 168
    help: "How long the session should stay alive before Slurm reclaims it."

  num_cores:
    label: "CPU cores"
    widget: "number_field"
    value: "8"
    min: 2
    max: 48
    step: 1
    help: |
      Cores for transcoding and cache work. 8 is a good default; raise it for
      large whole-slide images or many simultaneous viewers.

  memory_gb:
    label: "Memory (GB)"
    widget: "number_field"
    value: "24"
    min: 4
    max: 512
    step: 4
    help: "Total RAM for the session. Large 3-D or whole-slide images want more."

  cache_gb:
    label: "Disk cache (GB)"
    widget: "number_field"
    value: "64"
    min: 1
    max: 2048
    step: 1
    help: |
      On-demand transcoded chunks are cached on disk so revisiting an image is
      fast. The cache is per-session and is deleted when the session ends.

  monitor_sources:
    label: "Watch the data directory for changes"
    widget: "select"
    value: "false"
    options:
      - ["No  — index once at startup (recommended)", "false"]
      - ["Yes — re-scan continuously for new files", "true"]
    help: |
      Live monitoring polls the filesystem. On a large or slow shared filesystem
      that costs real I/O, so leave it off unless you are actively writing new
      data into this folder during the session.

  qos:
    label: "QOS"
    value: "general"
    help: |
      Slurm quality-of-service for the job. Leave it blank to let Slurm apply
      your account's default — no `--qos` is passed then.

      On this cluster: `general` (the default, 21-day limit), `himem`,
      `interactive`, `debug`, `preemptible`. `sacctmgr show assoc user=$USER
      format=QOS` lists the ones your account may actually use; a QOS you are
      not entitled to is rejected at submit time.

  login_host:
    label: "SSH login host"
    value: "<%= biopb_login_host %>"
    help: |
      The host you normally SSH into. Prefilled from your cluster's OnDemand
      configuration; correct it if your site uses a different name from off-site.

      Used for one thing only: the Arrow Flight tunnel command on the session
      card, for the Python/Java SDK and napari. The web UI does not need it — the
      portal proxies that. Leave it blank if you reach compute nodes directly.

form:
  - cluster
  - user_data_dir
  - bc_num_hours
  - num_cores
  - memory_gb
  - cache_gb
  - monitor_sources
  - qos
  - login_host
