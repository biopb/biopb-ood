---
# The `.erb` suffix is load-bearing: the dashboard renders this file through ERB
# only when the name ends in `.erb` (`BatchConnect::App#read_yaml_erb`). Named
# plain `form.yml`, every ERB tag below survives into the YAML as literal text —
# `cluster` then holds a string no cluster is named after, and the app refuses to
# open with "This app requires clusters that do not exist or you do not have
# access to."
#
# The cluster list is built from whatever OnDemand has configured in
# /etc/ood/config/clusters.d rather than hard-coded, so this app does not have to
# know the site's cluster id. If your site has exactly one cluster and you would
# rather not show the menu, delete `cluster` from the `form:` list below and add
# a top-level `cluster: "<your-cluster-id>"` key instead.
cluster:
  <%- OodAppkit.clusters.select(&:job_allow?).sort_by(&:id).each do |c| -%>
  - "<%= c.id %>"
  <%- end -%>
<%-
  # Default for `login_host` below, read from OnDemand's own cluster config
  # (`v2.login.host` in /etc/ood/config/clusters.d/<id>.yml) instead of naming a
  # site here. Same source the portal's Shell Access app uses.
  #
  # Fail-safe on purpose. A form that raises while rendering takes the whole
  # app down with it, and this is only the default for one editable text field —
  # so no clusters, no login section, or an OodAppkit that does not expose it all
  # degrade to blank rather than to a broken form. Blank is handled: the session
  # card then shows a direct ssh to the compute node, with a note about adding
  # -J yourself.
  #
  # Multi-cluster sites: this takes the first job-allowed cluster, and the form
  # renders once, so the default cannot follow the cluster menu. It stays
  # editable per session; a site that wants it to track the selection can drive
  # it from OnDemand's `data-set-*` option attributes.
  biopb_login_host = begin
    c = OodAppkit.clusters.select(&:job_allow?).sort_by(&:id).first
    (c && c.login && c.login.host).to_s
  rescue StandardError
    ""
  end

  # Default for `user_data_dir`. `~/data` if the user keeps one, otherwise the
  # home directory itself — always a real, readable path, so the field is never
  # empty on a first launch. (After that, OnDemand's per-user form cache wins:
  # this default is only ever seen by someone who has not launched the app
  # before, or whose cache file has been removed.)
  #
  # Same fail-safe shape as above: a raising form.yml takes the whole app down,
  # and this is one text field's starting value. A stat that fails — an
  # unreachable NFS home, a permission — degrades to the home path rather than
  # to a broken form.
  biopb_home = CurrentUser.home.to_s
  biopb_data_dir = begin
    candidate = File.join(biopb_home, "data")
    File.directory?(candidate) ? candidate : biopb_home
  rescue StandardError
    biopb_home
  end
-%>

attributes:
  user_data_dir:
    label: "Data directory"
    widget: "path_selector"
    directory: "<%= biopb_home %>"
    value: "<%= biopb_data_dir %>"
    show_files: false
    help: |
      The folder BioPB indexes and serves, recursively, with files left in their
      original format. Narrow it if you can: your whole home works, but the scan
      then walks code, environments and caches too.

  bc_num_hours:
    label: "Hours"
    value: "4"
    min: 1
    max: 168
    help: "How long the session should stay alive before Slurm reclaims it."

  num_cores:
    label: "CPU cores"
    widget: "number_field"
    value: "8"
    min: 2
    max: 48
    step: 1
    help: |
      8 is a good default; raise it for whole-slide images or heavy analysis.

  memory_gb:
    label: "Memory (GB)"
    widget: "number_field"
    value: "24"
    min: 4
    max: 512
    step: 4
    help: "Total RAM for the session. Large 3-D or whole-slide images want more."

  cache_gb:
    label: "Disk cache (GB)"
    widget: "number_field"
    value: "16"
    min: 1
    max: 2048
    step: 1
    help: |
      Cache for transcoded chunks, so revisiting an image is fast. Deleted when
      the session ends.

  monitor_sources:
    label: "Watch the data directory for changes"
    widget: "select"
    value: "true"
    options:
      - ["Yes — open now, index in the background (recommended)", "true"]
      - ["No  — index everything before opening", "false"]
    help: |
      Yes: the session opens in seconds and images appear as they are found,
      including files added later. Watching polls the filesystem.
      No: the session opens only after the whole directory has been indexed.

  flight_remote:
    label: "Arrow Flight access"
    widget: "select"
    value: "true"
    options:
      - ["Remote — connect over grpcs:// from your own machine (recommended)", "true"]
      - ["Loopback only — reach it through an SSH tunnel", "false"]
    help: |
      How the Python/Java SDK and napari reach the data. Remote: connect directly
      over TLS, no tunnel (the card shows the certificate fingerprint). Loopback
      only: nothing but the portal is reachable; the card gives an `ssh -L`
      command. The web UI is unaffected.

  rotate_flight_cert:
    label: "Rotate Arrow Flight certificate"
    widget: "select"
    value: "false"
    options:
      - ["No — keep the current certificate (recommended)", "false"]
      - ["Yes — mint a new one now", "true"]
    help: |
      Only if a session warned that the certificate is expiring. It replaces your
      account's certificate on every node; clients with a saved `tls_fingerprint`
      must be updated. Remote Flight only.

  enable_jupyter:
    label: "JupyterLab and agent terminal"
    widget: "select"
    value: "false"
    options:
      - ["No — dashboard and data browser only", "false"]
      - ["Yes — also start JupyterLab on this node", "true"]
    help: |
      Adds JupyterLab on this node. A notebook on the kernel *biopb: connect to
      the running biopb session* shares the session's `client` and `ops`, and its
      terminal can run an AI agent you have installed. Needs a JupyterLab this app
      can find (see INSTALL.md).

  jupyter_module:
    label: "JupyterLab module"
    value: "<%= ENV.fetch("BIOPB_OOD_JUPYTER_MODULE", "").to_s[/\A[A-Za-z0-9._+\/-]+\z/] %>"
    help: |
      The environment module that provides JupyterLab, used only if you have none
      of your own. Leave blank if you do, or your site puts it on the PATH.

  exclusive_node:
    label: "Exclusive node"
    widget: "select"
    value: "false"
    options:
      - ["No — share the node with other jobs", "false"]
      - ["Yes — no other job on this node (--exclusive)", "true"]
    help: |
      With JupyterLab on, the session's local endpoint has no token, so another
      user's job on the same node could run code as you. Yes keeps the node to
      yourself, for a longer queue wait. No is fine if your site never shares nodes.

  qos:
    label: "QOS"
    value: "general"
    help: |
      Slurm quality of service. Blank uses your account's default. Here:
      `general` (21-day limit), `himem`, `interactive`, `debug`, `preemptible`.
      `sacctmgr show assoc user=$USER format=QOS` lists the ones you may use.

  login_host:
    label: "SSH login host"
    value: "<%= biopb_login_host %>"
    help: |
      Used only for the tunnel command on the card, with Arrow Flight set to
      loopback. Prefilled from your cluster's OnDemand configuration. Blank if you
      reach compute nodes without a jump host.

form:
  - cluster
  - user_data_dir
  - bc_num_hours
  - num_cores
  - memory_gb
  - cache_gb
  - monitor_sources
  - flight_remote
  - rotate_flight_cert
  - enable_jupyter
  - jupyter_module
  - exclusive_node
  - qos
  - login_host
