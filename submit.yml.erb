---
# `bc_num_hours` from the form is turned into the job's wall time by OnDemand
# itself, so it is not repeated in `native` below.
batch_connect:
  template: "basic"
  # Extra variables copied out of the job environment into connection.yml so
  # view.html.erb can render them. `host` and `port` are always included; these
  # are the ones this app adds. Every name here must be exported by
  # template/before.sh.erb.
  conn_params:
    - biopb_token
    - login_host
    - data_dir
    - sidecar_port
    - grpc_port
    - ood_user
    # Whether the Flight plane was published, and the fingerprint a client should
    # expect if so. The card renders a grpcs:// endpoint or an ssh -L command
    # from these — before.sh.erb may downgrade the form's answer (no 'tls'
    # extra), so the card follows what actually happened, not what was asked.
    - flight_remote
    - flight_fingerprint
    # The address a client should actually dial -- grpcs://<host>:<port> or the
    # loopback grpc://, matching flight_remote. Computed once in before.sh.erb so
    # the card and the launcher (--grpc-external-location, biopb/biopb#1158)
    # never derive two different strings for the same session.
    - flight_url
    # The portal path this session is published at. Derived in before.sh and
    # passed to both the launcher (--url-prefix) and the card (the link target),
    # so the address biopb was told and the address the button opens cannot drift.
    - url_prefix
    # JupyterLab beside the session. `jupyter_requested` is what the form asked
    # for and `jupyter_enabled` what before.sh.erb could actually arrange (no
    # JupyterLab found -> not enabled), so the card follows what happened.
    - jupyter_requested
    - jupyter_enabled
    - jupyter_prefix
    - jupyter_token

script:
  job_name: "biopb-ood"
  native:
    # A blank QOS is meaningful: it submits with no --qos at all, so Slurm
    # applies the account default. Sites that do not use QOS therefore need no
    # edit here, they just clear the field.
    <%- unless qos.to_s.strip.empty? -%>
    - "--qos=<%= qos.strip %>"
    <%- end -%>
    <%- if enable_jupyter.to_s == "true" && exclusive_node.to_s == "true" -%>
    - "--exclusive"
    <%- end -%>
    - "--nodes=1"
    - "--ntasks=1"
    - "--cpus-per-task=<%= num_cores %>"
    - "--mem=<%= memory_gb %>G"
