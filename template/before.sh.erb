# --- one session per user --------------------------------------------------- #
#
# biopb's state tree is a singleton by construction: one control.pid, one
# control.json, one credential, one session registry, and a CLI of
# control start/stop/status. This app used to hand every session its own tree to
# work around that. Serving one server per user instead makes the tree in NFS
# home simply correct — and because ~/.local is mounted on every node, the TLS
# certificate, the access token and the discovery record become stable across
# sessions AND across nodes for free. That is the whole point of the change: the
# cert problem stops needing a solution.
#
# Slurm is the authority for "is another session alive", not control.json. The
# record is published on serve and retracted only on a *clean* stop, so scancel,
# an OOM kill or a node failure leaves it behind — a record-based guard would
# refuse to start forever, and the user could not fix it from the portal. Slurm
# knows the job is gone. The record is consulted only for *where* to send them.
BIOPB_JOB_NAME="biopb-browser"
BIOPB_STATE="${HOME}/.local/state/biopb"

# Every other live job of this app, one "<jobid> <node>" per line. COMPLETING is
# included deliberately: such a job still holds its port and its state tree.
others="$(squeue -h -u "${USER}" -n "${BIOPB_JOB_NAME}" \
            -t RUNNING,CONFIGURING,COMPLETING -o '%i %N' 2>/dev/null \
          | awk -v me="${SLURM_JOB_ID:-0}" '$1 != me' || true)"

# Two launches a second apart would each see the other, so a plain "refuse if any
# other exists" makes both yield and neither start. Slurm job ids are monotonic,
# so let the elder win: each side applies the same tie-break to the same list and
# exactly one proceeds. No lock file, and in particular no flock on NFS.
elder="$(awk -v me="${SLURM_JOB_ID:-0}" '$1 < me {print; exit}' <<<"${others}" || true)"

if [[ -n "${elder}" ]]; then
  elder_id="${elder%% *}"
  elder_node="${elder##* }"

  # Qualify the node the same way this file qualifies its own, or the portal's
  # host_regex may not match a short name and the link 404s past the proxy.
  our_fqdn="$(timeout 5 hostname -f 2>/dev/null || true)"
  case "${our_fqdn}" in
    *.*) elder_node="${elder_node}.${our_fqdn#*.}" ;;
  esac

  # The port, and ONLY the port, comes from the discovery record: its "host" is
  # the bind address (0.0.0.0 on this branch), which is not a name anything can
  # dial. The node name comes from Slurm above.
  elder_port=""
  if [[ -r "${BIOPB_STATE}/control.json" ]]; then
    elder_port="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1]))["port"])
except Exception: pass' "${BIOPB_STATE}/control.json" 2>/dev/null || true)"
  fi

  echo "ERROR: you already have a BioPB session running (job ${elder_id} on ${elder_node})." >&2
  echo "       One server per user: this session would fight it for the same" >&2
  echo "       credential, log and session registry in ${BIOPB_STATE}." >&2
  if [[ -n "${elder_port}" ]]; then
    echo "       Open the running one at /node/${elder_node}/${elder_port}/" >&2
  else
    echo "       It has not published its endpoint yet — give it a moment, then" >&2
    echo "       open it from My Interactive Sessions." >&2
  fi
  echo "       To start fresh instead, delete that session and relaunch." >&2
  exit 1
fi

# No live sibling. A record still sitting here is therefore from a job that did
# not stop cleanly; drop it so nothing downstream (and no client discovering
# through it) is pointed at a dead endpoint. biopb republishes on serve.
if [[ -e "${BIOPB_STATE}/control.json" ]]; then
  echo "Note: removing a stale control record left by a previous session." >&2
  rm -f "${BIOPB_STATE}/control.json"
fi

# Allocate the ports and the access token for this session.
#
# BioPB runs three listeners and derives them from one base port, the same
# convention the container uses (BIOPB_BASE_PORT):
#
#   base + 3  control plane  — the browser origin: serves the web UI, proxies
#                              the rest. This is the port you tunnel to.
#   base + 4  HTTP sidecar   — the data-plane REST/WS API the UI calls
#   base + 5  Arrow Flight   — the gRPC data plane (SDK clients, napari)
#
# Allocating a *contiguous* base rather than three loose ports means this app
# drives either biopb CLI generation unchanged: the 0.12.0 release takes
# BIOPB_CONTROL_PORT + --web-port, while newer builds take a single --base-port.
# See template/script.sh.erb.
#
# The control plane is published through OnDemand's own proxy, so it binds the
# node's interfaces rather than loopback (see template/script.sh.erb). The
# sidecar and the Flight plane stay on 127.0.0.1 — nothing outside the node
# talks to them directly.

# --- what the portal will call this node ------------------------------------ #
# OnDemand sets `host=$(hostname)` just before sourcing this file — the node's
# *short* name. Whether that works depends on the portal's `host_regex` in
# ood_portal.yml: a site that qualifies it with a domain never matches a short
# name, and the request falls past the proxy to Apache's document root, so the
# session card leads to a bare 404 with no hint that the name was the problem.
#
# Prefer the fully qualified name whenever the node reports one; keep
# OnDemand's value if it does not. `host` is exported and read afterwards by
# both connection.yml and the url_prefix below, so fixing it here fixes every
# consumer at once.
# Bounded: `hostname -f` consults the resolver, and a wedged one would
# otherwise hang the whole job here, before anything has been started.
fqdn="$(timeout 5 hostname -f 2>/dev/null || true)"
case "${fqdn}" in
  *.*) host="${fqdn}" ;;
esac
export host

# Find a base port whose +3/+4/+5 offsets are all free. find_port already
# returns something unused, so this only has to clear the three derived ports.
find_base_port () {
  local h="$1" b attempt
  for attempt in $(seq 1 64); do
    b="$(find_port "${h}" 9000 60000)"
    if ! port_used "${h}:$((b + 3))" \
       && ! port_used "${h}:$((b + 4))" \
       && ! port_used "${h}:$((b + 5))"; then
      echo "${b}"
      return 0
    fi
  done
  return 1
}

base_port="$(find_base_port "${host}")" || {
  echo "ERROR: could not find three consecutive free ports on ${host}" >&2
  exit 1
}

export base_port
export control_port=$((base_port + 3))
export sidecar_port=$((base_port + 4))
export grpc_port=$((base_port + 5))

# OnDemand's canonical connection port. The control plane is the only listener a
# human ever talks to, so that is what the portal proxies to.
export port="${control_port}"

# Where the portal publishes this session: OnDemand's /node/<host>/<port>/ route
# passes the full, untouched path through to us, so biopb has to be *told* the
# prefix it is serving under (biopb/biopb#731). It cannot be inferred from a
# request header — a caller-controlled `<base href>` would repoint every relative
# URL in the SPA — and it cannot be baked at build time, because it carries this
# job's node and port. Derived once, here, and passed to both the launcher (as
# --url-prefix) and the session card (as the link), so the two cannot disagree.
#
# `/node` is OnDemand's default node_uri. If your portal sets a different one in
# ood_portal.yml, change it here.
export url_prefix="/node/${host}/${port}"

# Gates the web UI and the data API. Alphanumeric from create_passwd, which
# satisfies biopb's 16-128 URL-safe character rule. It is the *only* thing
# standing between this session and anyone else: the control port is open on the
# node's interfaces so the portal can proxy to it, and even the loopback-bound
# sidecar and Flight ports are reachable by every other user on this shared node.
export biopb_token="$(create_passwd 32)"

# Copied into connection.yml for the session card (see submit.yml.erb). The
# username is resolved here rather than in the view, so the card does not depend
# on a dashboard helper being in scope when it renders.
#
# Form values are reached as `context.<id>`, not bare. The dashboard renders the
# staged templates with `TemplateBinding.new(session, context)` (a two-member
# Struct with no method_missing), so `session` and `context` are the *only*
# names in scope here. submit.yml.erb is the one that gets an OpenStruct of the
# form, which is why bare `<%%= qos %>` is right there and wrong here. (And that
# escape is why this comment does not blow up: ERB reads comments too.)
export login_host="<%= context.login_host %>"
export data_dir="<%= context.user_data_dir %>"
export ood_user="${USER:-$(id -un)}"
