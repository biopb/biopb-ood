#!/usr/bin/env bash
#
# Launch the BioPB stack for one OnDemand session.
#
# `biopb-control run` is the whole deployment in one foreground process: it
# serves the web UI, supervises the Arrow Flight data plane as a child, and
# reverse-proxies that child's HTTP sidecar under /data_plane. It is the ONLY
# component that serves the browser bundle — the tensor server's sidecar carries
# no static assets, and neither does the biopb-tensor-server container image,
# which is a headless Flight-only data plane. That is why this app runs the full
# stack from the shared home install rather than the .sif.

set -euo pipefail

STAGED_ROOT="${PWD}"
# The user's own biopb.json, where biopb looks by default (BIOPB_CONFIG_HOME is
# its documented override; biopb 0.14+ ignores XDG_CONFIG_HOME). Not generated per
# launch: the admin page's PUT /api/config writes this same file, so what the user
# saves there is what the next launch serves. Everything the launch form used to
# decide (data directory, cache size, watching) now lives in it.
CONFIG_FILE="${BIOPB_CONFIG_HOME:-${HOME}/.config/biopb}/biopb.json"

# --- optional per-user dev override ---------------------------------------- #
#
# ~/.config/biopb-ood/dev.env, if present, is sourced here to point the app at a
# build tree instead of the `uv tool` install -- e.g.
#
#   BIOPB_BIN_DIR=$HOME/work/biopb/.venv/bin
#   BIOPB_WEBAPP_DIR=$HOME/work/biopb/web/packages/app/dist
#
# A file rather than the portal's environment because a user cannot set that.
# Remove or rename the file to go back to the installed biopb. Sourced in both
# before.sh.erb and script.sh.erb, each of which resolves the bin dir itself;
# sourcing twice is harmless.
BIOPB_DEV_ENV="${BIOPB_DEV_ENV:-${HOME}/.config/biopb-ood/dev.env}"
if [[ -r "${BIOPB_DEV_ENV}" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "${BIOPB_DEV_ENV}"
  set +a
  echo "NOTE: DEV MODE -- ${BIOPB_DEV_ENV} sets BIOPB_BIN_DIR=${BIOPB_BIN_DIR:-<unset>}" \
       "BIOPB_WEBAPP_DIR=${BIOPB_WEBAPP_DIR:-<unset>}" >&2
fi

# --- where the install lives ---------------------------------------------- #
#
# Resolved from the environment as the *launching user* has it. A site that
# ships biopb as a module may well set BIOPB_DATA_HOME (or XDG_DATA_HOME on an
# older module), and that has to keep pointing at the module's bundle.
#
# Both are overridable for the same reason: the CLI and the bundle may come from
# a build tree rather than ~/.local — and they must come from the *same* tree.
BIOPB_BIN_DIR="${BIOPB_BIN_DIR:-${HOME}/.local/bin}"
WEBAPP_DIR="${BIOPB_WEBAPP_DIR:-${BIOPB_DATA_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}}/biopb/webapp}"
export PATH="${BIOPB_BIN_DIR}:${PATH}"

# --- state lives in the user's home, on purpose ---------------------------- #
#
# This app runs ONE server per user (see the guard in before.sh.erb), so biopb's
# own base dirs are left exactly where biopb puts them: ~/.config/biopb,
# ~/.local/state/biopb, ~/.local/share/biopb. Nothing is redirected per session.
#
# That is a deliberate reversal. Giving each session its own tree fought biopb's
# design — the state tree is a singleton by construction (one control.pid, one
# control.json, one credential, one session registry, and a CLI of
# control start/stop/status) — and it cost more than it bought. Because ~/.local
# is the same NFS tree on every node, keeping state in home means the TLS
# certificate, the access token and the discovery record are stable across
# sessions AND across nodes at no cost: the cert is minted once and reused
# wherever the scheduler puts the job, instead of being re-minted per session and
# breaking every client's TOFU pin (biopb/biopb#913).
#
# What is still passed explicitly: --config (the same ~/.config/biopb/biopb.json
# biopb would find on its own; passed so the launcher and the admin page cannot
# disagree about which file) and --static-dir (the bundle captured above, so a
# leftover ~/.local/share/biopb/webapp cannot change which UI a session serves).
#
# What the config file does NOT decide, because the control passes it on the
# command line and the flag wins: server.host and server.port. A user who saves a
# different port in the admin page changes the file and nothing else, so the
# session card's address stays right.
#
# The one thing this gives up: the data plane's log lands in
# ~/.local/state/biopb/logs on NFS home rather than node-local disk. Passed
# explicitly below (--server-log) to `biopb-control run`, matching the path
# biopb's own CLI used to hardcode (biopb/cli.py, server_log=_get_log_file())
# before biopb/biopb#736 retired it -- deliberately kept as-is here rather than
# also moving it to node-local disk (like SESSION_TMP below) in the same
# change: at --log-level INFO with a single server per user the volume is
# small, and that move is its own decision, not a side effect of this one.

# The transcode cache. The config does not name a directory unless the user adds
# one, and then biopb uses $TMPDIR (else /tmp)/biopb-cache-<uid>: node-local, which
# is where it belongs -- it is written constantly, it is worthless after the job
# ends, and the file backend takes a cross-process lock that NFS would make slow.
# This script no longer sets it, so SESSION_TMP below is only for the scientific
# stack's caches and Jupyter's runtime dir.
SESSION_TMP="${TMPDIR:-/tmp}/biopb-ood-${SLURM_JOB_ID:-$$}"
# biopb itself does not read XDG_CACHE_HOME -- this is for the scientific stack
# underneath it (font/JIT/plugin caches), which otherwise lands in NFS home and
# is written by every concurrent session on the cluster at once. It is an XDG
# name because its audience is matplotlib/numba/Qt, not biopb -- biopb's own dirs
# are BIOPB_* and are deliberately left alone above.
export XDG_CACHE_HOME="${SESSION_TMP}/xdg-cache"
mkdir -p "${XDG_CACHE_HOME}"

# Warn when the default cache location is not a local disk. /tmp is usually one
# but not always: some sites mount it as RAM (the cache then eats the job's
# memory) or on network storage. Warn rather than fail -- the session works either
# way, just slower. Checks the default location only; a file_cache_dir the user
# set in biopb.json is theirs to have chosen. Best effort: a df that cannot
# answer says nothing.
CACHE_PROBE="${TMPDIR:-/tmp}"
if cache_df="$(df -P -T -k "${CACHE_PROBE}" 2>/dev/null | tail -n 1)" && [[ -n "${cache_df}" ]]; then
  read -r _ cache_fstype _ _ cache_avail_kb _ <<<"${cache_df}"
  case "${cache_fstype}" in
    tmpfs|ramfs)
      echo "WARNING: ${CACHE_PROBE} is on ${cache_fstype} (RAM), so the default cache directory" >&2
      echo "         counts against this job's memory. Set TMPDIR to a local disk, if the node has one." >&2 ;;
    nfs*|lustre|gpfs|beegfs|panfs|ceph|cifs|smb*|fuse*)
      echo "WARNING: ${CACHE_PROBE} is on ${cache_fstype}, not a local disk, so the default cache" >&2
      echo "         directory will be slow. Set TMPDIR to a local disk, if the node has one." >&2 ;;
  esac
fi

# Jupyter's runtime dir holds the session kernel's connection file, whose key is
# the only thing between another user on this node and that kernel. Node-local
# and private to this job, rather than the default under NFS home: nothing else
# there can be mistaken for this job's session (a file left by a job that ran on
# another node), and nothing readable lands on shared storage. Exported before
# the control starts so its session child and the Lab process both inherit it.
# Harmless when JupyterLab is off: the session simply writes its file here.
export JUPYTER_RUNTIME_DIR="${SESSION_TMP}/jupyter-runtime"
mkdir -p "${JUPYTER_RUNTIME_DIR}"
chmod 700 "${JUPYTER_RUNTIME_DIR}"
# Set once JupyterLab is started (below); cleanup stops it, and it takes its
# notebook kernels and terminals down with it.
LAB_PID=""
cleanup () {
  if [[ -n "${LAB_PID}" ]]; then kill "${LAB_PID}" 2>/dev/null || true; fi
  rm -rf "${SESSION_TMP}" 2>/dev/null || true
}
trap cleanup EXIT

# Java is only needed for the Bio-Formats fallback readers (.zvi, .ims, .oif).
# Everything else is native Python, so a missing module is not fatal.
if command -v module >/dev/null 2>&1; then
  module load java/21.0.2 >/dev/null 2>&1 || true
fi

if ! command -v biopb >/dev/null 2>&1; then
  echo "ERROR: 'biopb' not found on PATH." >&2
  echo "Install it with:  curl -fsSL https://biopb.org/install.sh | bash" >&2
  exit 1
fi

# `biopb-control` is its own console script (biopb-control/pyproject.toml),
# installed alongside `biopb` by the same installer -- absent only if the
# shared env is unusually broken, since the two always land together.
if ! command -v biopb-control >/dev/null 2>&1; then
  echo "ERROR: 'biopb-control' not found on PATH (biopb/biopb#736 -- this app" >&2
  echo "       runs 'biopb-control run' directly rather than the retired" >&2
  echo "       'biopb control run')." >&2
  echo "Re-run the installer:  curl -fsSL https://biopb.org/install.sh | bash" >&2
  exit 1
fi

if [[ ! -f "${WEBAPP_DIR}/index.html" ]]; then
  echo "ERROR: the web UI bundle is missing at ${WEBAPP_DIR}." >&2
  echo "Re-run the biopb installer to restore it." >&2
  exit 1
fi

# --- how far the Flight plane reaches --------------------------------------- #
#
# Set by the "Arrow Flight access" form field and resolved in before.sh.erb,
# which also makes sure a certificate exists (and downgrades to loopback if it
# could not; see before.sh.erb for why one certificate, minted once, works from
# every node). Two knobs move together, and they must agree:
# biopb defaults TLS to ON for a public --grpc-bind and off for loopback, so
# passing them as a pair keeps the exposure and its protection from drifting
# apart in a later edit.
#
# The token is what actually gates the port in both cases. On a public bind
# biopb REQUIRES one, which this app has already supplied via
# BIOPB_TENSOR_TOKEN; TLS is what stops it crossing the cluster network in the
# clear, which is exactly what --no-tls on a public bind would do.
# An array, not a string: `biopb-control run`'s --tls (biopb_control/__main__.py)
# is a plain store_true with no --no-tls counterpart (unlike the retired typer
# command's tri-state flag), so "off" means omitting it, not passing a value
# argparse would reject.
if [[ "${flight_remote:-false}" == "true" ]]; then
  grpc_bind="0.0.0.0"
  tls_flag=(--tls)
  flight_desc="${host}:${grpc_port}  (grpcs://, TLS)"
else
  grpc_bind="127.0.0.1"
  tls_flag=()
  flight_desc="127.0.0.1:${grpc_port}  (loopback; reach it with ssh -L)"
fi

# A first launch on an account that never ran the biopb installer has no config.
# Seed the smallest valid one (nothing indexed yet; add sources in the admin page)
# rather than failing. An existing file is never touched.
#
# The persistent catalog (hand-drawn ROIs, decode-rate measurements) needs no
# setting: biopb names it by a digest of this config's path, and the path is now
# the same on every launch, so the same catalog is reopened each time. It lives in
# ~/.local/state/biopb/catalogs, in home and not node-local, so it follows the
# user across nodes. DuckDB holds an exclusive lock on it; the one-session guard
# in before.sh.erb is what keeps two sessions off it.
if [[ ! -e "${CONFIG_FILE}" ]]; then
  mkdir -p "$(dirname "${CONFIG_FILE}")"
  printf '{\n  "server": {"aggressive_dir_pruning": true},\n  "sources": []\n}\n' > "${CONFIG_FILE}"
  echo "Note: no ${CONFIG_FILE} yet; wrote an empty one. Add data sources in the admin page." >&2
fi

echo "BioPB session starting on $(hostname)"
echo "  config         : ${CONFIG_FILE}"
echo "  control (UI)   : 0.0.0.0:${control_port}  (portal proxy target)"
echo "  published at   : ${url_prefix}/"
echo "  HTTP sidecar   : 127.0.0.1:${sidecar_port}"
echo "  Arrow Flight   : ${flight_desc}"
if [[ "${jupyter_enabled:-false}" == "true" ]]; then
  echo "  JupyterLab     : 0.0.0.0:${jupyter_port}  (published at ${jupyter_prefix}/)"
fi

# This branch serves the UI through OnDemand's proxy, which requires a biopb
# carrying --url-prefix (biopb/biopb#731). Without it the control emits a shell
# whose asset and API URLs are anchored at the *portal* root, so the page would
# load nothing behind the proxy — and it would fail as a blank screen rather than
# as an error. Refuse up front instead.
if ! biopb-control run --help 2>/dev/null | grep -q -- '--url-prefix'; then
  echo "ERROR: this biopb install does not support --url-prefix." >&2
  echo "       The portal-proxied app needs biopb/biopb#731, which shipped in" >&2
  echo "       biopb 0.14. Either upgrade biopb, or use this app's 'tunnel'" >&2
  echo "       branch, which reaches the same stack over an SSH tunnel and" >&2
  echo "       works on 0.12.0." >&2
  exit 1
fi

# The OnDemand proxy runs on the portal's web node and connects to this compute
# node over the network, so the control cannot stay on loopback the way biopb's
# default assumes. BIOPB_CONTROL_HOST is biopb's documented escape hatch for the
# control bind (`biopb.control._endpoints.control_host`: env var takes top
# precedence over the served default). The access token gates it; the sidecar
# is unaffected and stays on 127.0.0.1, and the Flight plane binds wherever the
# form asked (see above).
#
# The cost, stated plainly: portal -> compute node is plain HTTP, so the token
# crosses the cluster network in the clear (biopb/biopb#614 — the control has no
# TLS). Browser -> portal is HTTPS. This is the same posture as every OnDemand
# Jupyter app, and it is the reason the `tunnel` branch still exists. Note this
# is the CONTROL plane only: remote Flight above carries the same token, but
# inside TLS, so the two planes do not have the same exposure.
export BIOPB_CONTROL_HOST=0.0.0.0
export BIOPB_TENSOR_TOKEN="${biopb_token}"

# How this control is authenticated. biopb 0.16 builds after #1388 take it from this
# variable instead of inferring "loopback or not" from the bind; earlier builds
# ignore it. `token` is one token for everything: it views data AND, because it
# rides over this app's plaintext portal-to-node hop, is also what lets a holder use
# the dashboard's chat pane and the session's /mcp (code in the kernel). That is the
# accepted trade (see DESIGN-NOTES.md), and the control logs a warning about it at
# startup on a non-loopback bind: expected here, not a fault.
#
# Pinned, not left to inference, because biopb infers `split` (a second, exec token)
# from the mere presence of BIOPB_CONTROL_EXEC_TOKEN in the environment. A stray one
# would then silently turn chat and kernel controls off in the dashboard. Pinned,
# the same stray value stops the launch with "--auth token takes no exec token",
# which names the cause. Unset it, or change this line to `split` on purpose.
export BIOPB_CONTROL_AUTH=token

# Tell every biopb process started from this environment -- the session, and
# whatever Lab's terminals launch -- where the control is. This control is a
# foreground `biopb-control run` on an unconventional port, so it publishes
# control.json but not the daemon pid file that `biopb control start` uses to
# decide "already running". The biopb-mcp stdio shim runs that command on its
# first tool call; without this it finds no daemon, sees the default 8813 free,
# and starts a SECOND control there -- which then overwrites control.json, so the
# session reports a loopback viewer URL on the wrong control instead of this
# session's proxied one. BIOPB_CONTROL_PORT takes top precedence for both the
# start path (`_control_bind_endpoint`) and every reader (`control_port`), so
# the shim's start now targets a port that is in use and refuses, and clients
# resolve to this control without consulting the record. It matches the
# --control-port passed below; keep the two together.
export BIOPB_CONTROL_PORT="${control_port}"

# With the url_prefix, what the control publishes as the address the user's
# browser reaches it by (`user_url` in its discovery record), which is the link
# an agent hands the user. By environment, not a flag, so a biopb that predates it
# ignores it rather than refusing to start.
if [[ -n "${public_origin:-}" ]]; then
  export BIOPB_PUBLIC_ORIGIN="${public_origin}"
else
  unset BIOPB_PUBLIC_ORIGIN
fi

# `biopb-control run`, not the retired `biopb control run` (biopb/biopb#736 --
# the typer wrapper built the deployment in-process and never enforced the
# fail-closed guard this entry point already carries on a public
# --control-host). It takes the three listeners' host/port pairs individually
# rather than deriving them from --base-port; before.sh.erb already computed
# each one explicitly to pick them (find_base_port), so nothing new needs
# resolving here.
#
# --grpc-external-location (biopb/biopb#1158) is what lets the tensor server
# advertise flight_url -- the same address the session card shows -- to any
# consumer it forwards a SerializedTensor or dask graph to, instead of baking
# in whatever address it dialed itself with. flight_url already equals the
# loopback default when flight_remote is false, so passing it is a no-op in
# that case. Passed unconditionally, gated only by the biopb version this app
# is paired with (see INSTALL.md), not by a runtime capability probe.
# Where the data plane's log ends right now, so the readiness gate below reads only
# what this launch wrote. The file is shared with every earlier launch.
SERVER_LOG="${BIOPB_STATE}/logs/tensor-server.log"
SERVER_LOG_START="$(stat -c %s "${SERVER_LOG}" 2>/dev/null || echo 0)"

biopb-control run \
  --config "${CONFIG_FILE}" \
  --static-dir "${WEBAPP_DIR}" \
  --control-port "${control_port}" \
  --grpc-host "${grpc_bind}" --grpc-port "${grpc_port}" \
  --grpc-external-location "${flight_url}" \
  --web-host 127.0.0.1 --web-port "${sidecar_port}" \
  --server-log "${BIOPB_STATE}/logs/tensor-server.log" \
  "${tls_flag[@]}" \
  --url-prefix "${url_prefix}" \
  --log-level INFO &
CONTROL_PID=$!

# Wait for the browser origin to be serving before declaring the session ready.
#
# The gate is HTTP 200 on /data_plane/readyz — the sidecar's health probe, which
# lives at the sidecar ROOT (not under /api/*) and reaches it through the
# control's prefix-stripping /data_plane mount. Do NOT gate on the control's own
# data_plane.state=="serving": that reflects a TCP probe of the Flight port,
# which comes up about two seconds before the sidecar binds, so the UI would
# still 502.
#
# What a 200 means depends on which biopb you are on, and waiting for one is
# right either way:
#
#   before 0.13.0        /readyz answered 200 unconditionally, including while
#                        it reported "degraded" with no backend connection at
#                        all (biopb/biopb#755). The gate passed early — the
#                        session was announced before the catalog existed.
#   0.13.0 and later     /readyz connects to Flight, answers from that health
#                        alone, and 503s until it says SERVING — so a 200 means
#                        a data plane that is genuinely there. This is the floor
#                        this app requires anyway, so it is the normal case; the
#                        row above only describes what a 0.12.x install did.
#
# SERVING is *not* a promise of a complete catalog. Under progressive discovery
# (biopb/biopb#212) the server reaches SERVING immediately and populates in the
# background, carrying freshness in full_scan_in_progress and
# last_full_scan_finished_at; a client that needs the whole catalog waits on
# those, not on SERVING.
#
# Both settings of this app's "Watch the data directory" field now behave the same
# way here: the server binds and reaches SERVING at once and the catalog fills
# behind it, so this gate normally clears in seconds and the UI opens on a catalog
# still growing. The field only decides what happens after that scan -- No
# (`monitor` false, the default) walks the directory once; Yes walks it again every
# pass to pick up new files. Before biopb 0.16 a "No" directory was walked
# *before* anything bound, and nothing answered until it finished.
#
# The 15-minute budget dates from that case and is kept as a generous ceiling.
# Timing out is not fatal — the session stays up.
# The one startup failure that is the user's to fix and looks like a hang from the
# portal: another process already holds the persistent catalog. biopb opens it
# exclusively, and the file is in NFS home, so the holder can be on ANY node -- a
# control the installer started, `biopb control start`, or an agent session. The
# data plane logs it and exits, the control stays up, and without this the session
# card goes live on a UI with no data plane behind it.
#
# Nothing on disk says which node. control.json has a port and a pid but no node,
# and it is no help here anyway: this launch's own control has just overwritten it.
# So the hint is the user's other Slurm jobs, which is where an interactive biopb
# is usually running; a login node, which Slurm does not list, is the other likely
# place.
catalog_lock_failure () {
  local new_log
  [[ -r "${SERVER_LOG}" ]] || return 1
  if [[ "$(stat -c %s "${SERVER_LOG}" 2>/dev/null || echo 0)" -ge "${SERVER_LOG_START}" ]]; then
    new_log="$(tail -c "+$(( SERVER_LOG_START + 1 ))" "${SERVER_LOG}" 2>/dev/null || true)"
  else
    new_log="$(cat "${SERVER_LOG}" 2>/dev/null || true)"   # rotated since the snapshot
  fi
  # Two locks, same cause. The catalog is in NFS home, so its holder can be on any
  # node. The default cache directory is node-local, so its lock only collides with
  # a biopb on THIS node, and is hit first when there is one.
  local what
  if grep -q 'Could not set lock on file\|Could not open the catalog' <<<"${new_log}"; then
    what="catalog : $(grep -o '/[^" ]*\.duckdb' <<<"${new_log}" | head -n 1)"
  elif grep -q 'Cannot acquire cache lock' <<<"${new_log}"; then
    what="cache   : $(grep -o '/[^ ]*/lock' <<<"${new_log}" | head -n 1)  (so it is on THIS node)"
  else
    return 1
  fi
  {
    echo "ERROR: another biopb process is already running from this account, so the data"
    echo "       plane cannot start."
    echo "         ${what}"
    echo "         config  : ${CONFIG_FILE}"
    echo "       The catalog is named after the config file, so any biopb run from that same"
    echo "       config -- the one the biopb installer starts, \`biopb control start\`, or an"
    echo "       agent session -- opens the same one, and only one process can. It may be on"
    echo "       another node: the file is in your home directory."
    echo "       Find it and stop it, then relaunch:"
    echo "         - on the node where it runs:  biopb control stop     (\`biopb control status\` shows it)"
    echo "         - your other Slurm jobs, any of which could be hosting it:"
    squeue -h -u "${USER}" -o '           %i  %j  on %N' 2>/dev/null | awk -v me="${SLURM_JOB_ID:-0}" '$1 != me' || true
    echo "         - a login node is not in that list; check it too."
  } >&2
  return 0
}

echo "Waiting for the data plane (normally seconds; up to 15 minutes)"
READY=0
for attempt in $(seq 1 450); do
  if ! kill -0 "${CONTROL_PID}" 2>/dev/null; then
    echo "ERROR: the control plane exited during startup." >&2
    wait "${CONTROL_PID}" || true
    exit 1
  fi
  code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 \
      -H "Authorization: Bearer ${biopb_token}" \
      "http://127.0.0.1:${control_port}/data_plane/readyz" 2>/dev/null || true)"
  if [[ "${code}" == "200" ]]; then
    READY=1
    break
  fi
  if catalog_lock_failure; then
    kill "${CONTROL_PID}" 2>/dev/null || true
    wait "${CONTROL_PID}" 2>/dev/null || true
    exit 1
  fi
  # A line a minute rather than 450 dots, and it names the last status: 503 is
  # "still scanning", anything else (000, 502) is "the sidecar is not answering
  # yet". Straight to the job output, which is where anyone debugging looks.
  if (( attempt % 30 == 0 )); then
    echo "  still waiting after $(( attempt * 2 / 60 )) min (last /readyz: ${code:-none})"
  fi
  sleep 2
done

if [[ "${READY}" == "1" ]]; then
  # The readiness gate above probes the *unprefixed* path over loopback, which a
  # prefixed control still answers. That is not what the portal will ask for, so
  # confirm the published document once: the shell must come back carrying the
  # <base href> the SPA reads its prefix from. A 200 without it means the bundle
  # predates biopb/biopb#731 even though the CLI accepted the flag, which would
  # otherwise surface as a blank page with no explanation.
  shell="$(curl -s -m 5 "http://127.0.0.1:${control_port}${url_prefix}/" 2>/dev/null || true)"
  if grep -q "<base href=\"${url_prefix}/\">" <<<"${shell}"; then
    echo "BioPB is ready, published at ${url_prefix}/"
  else
    echo "WARNING: the control is up but the page served at ${url_prefix}/ carries" >&2
    echo "         no <base href>, so the browser will resolve its assets at the" >&2
    echo "         portal root and the UI will come up blank. The installed web" >&2
    echo "         bundle is probably older than the CLI — reinstall biopb so the" >&2
    echo "         two match." >&2
  fi
else
  echo "WARNING: the data plane did not report ready within 15 minutes." >&2
  echo "         The session is left up anyway and may still come ready. Check the" >&2
  echo "         log above, and /data_plane/readyz for a backend_error." >&2
fi

# --- JupyterLab -------------------------------------------------------------- #
#
# Only when the form asked for it and before.sh.erb found a JupyterLab.
#
# No biopb session is started here. A session is a kernel process that holds
# memory for as long as it lives, and nothing needs one until somebody asks:
#
#   - An agent's stdio shim starts unbound and asks the control for a session when
#     the agent attaches, launching one if none is free. BIOPB_CONTROL_PORT,
#     exported above, is how it finds *this* control instead of starting its own.
#   - The dashboard can start one too.
#   - A notebook's `biopb-session` kernel spec attaches to whichever session is
#     live (the newest connection file in JUPYTER_RUNTIME_DIR), so a notebook
#     opened before any session exists answers "no running biopb session" until
#     an agent or the dashboard has made one.
#
# Starting one here as well would leave an unused kernel running for the whole
# job and, before 0.16, was the only way to give the notebook and an agent the
# same namespace; the shim now attaches to an existing session instead of
# spawning its own.
#
# A Lab that never comes up leaves the viewer as it was.
if [[ "${jupyter_enabled:-false}" == "true" ]]; then
  # An array so an empty extra is no argument at all. The origin pattern is an
  # escape hatch for a portal whose proxy does not preserve the Host header, which
  # Jupyter's websocket origin check compares against; without one Lab loads but
  # its kernels and terminals fail with a 403. See INSTALL.md.
  lab_extra=()
  if [[ -n "${BIOPB_OOD_JUPYTER_ORIGIN_PAT:-}" ]]; then
    lab_extra+=("--ServerApp.allow_origin_pat=${BIOPB_OOD_JUPYTER_ORIGIN_PAT}")
  fi

  # The token goes in the environment, not on the command line: argv is world
  # readable in ps on a shared node. The module (if any) is loaded around this
  # process alone -- see before.sh.erb for why it must not reach the rest.
  (
    if [[ -n "${jupyter_module:-}" ]]; then
      # What the job had before the module: a terminal in Lab gets these back
      # (terminal-shell.sh). The module's PYTHONPATH is its own Python's, and the
      # biopb tools an agent runs in that terminal are another's.
      if [[ -n "${PYTHONPATH+x}" ]]; then export BIOPB_TERMINAL_PYTHONPATH="${PYTHONPATH}"; fi
      if [[ -n "${PYTHONHOME+x}" ]]; then export BIOPB_TERMINAL_PYTHONHOME="${PYTHONHOME}"; fi
      module load "${jupyter_module}" >/dev/null 2>&1 || true
    fi
    export JUPYTER_TOKEN="${jupyter_token}"

    # Once, since each run starts a Python.
    lab_config="$("${jupyter_bin}" --show-config 2>/dev/null || true)"

    # The web terminal is a server extension (jupyter_server_terminals), and an
    # extension is only on if a config file says so. A module-installed Jupyter
    # (Spack, Lmod) keeps each package in its own prefix, so those config files
    # are not on Jupyter's search path: the package imports fine, yet the Lab has
    # no terminals API and no Terminal tile. Turn it on -- but only when the
    # merged config does not already name it, so a site that enabled it is left
    # alone and one that disabled it on purpose is not overridden. (The separate
    # `terminals_enabled = False` switch still wins either way.) Naming an
    # extension that is not installed only logs a warning; Lab starts regardless.
    if ! grep -q "jupyter_server_terminals" <<<"${lab_config}"; then
      lab_extra+=("--ServerApp.jpserver_extensions={'jupyter_server_terminals': True}")
    fi

    # A Lab from a module hands its PYTHONPATH to every terminal; give them the
    # job's own back (terminal-shell.sh). Only when a module was loaded, and not
    # over a terminal command the site's config already sets. The path goes into
    # a Python literal, so a quote in it is left alone rather than escaped.
    if [[ -n "${jupyter_module:-}" && -f "${STAGED_ROOT}/terminal-shell.sh" \
          && "${STAGED_ROOT}" != *\'* ]] \
       && ! grep -q "terminado_settings" <<<"${lab_config}"; then
      lab_extra+=("--ServerApp.terminado_settings={'shell_command': ['/bin/bash', '${STAGED_ROOT}/terminal-shell.sh']}")
    fi

    # Kept running for as long as the session is. The control, the data plane and
    # the biopb session last days, but a site's Jupyter config can shut the Lab
    # down on its own ("No kernels for N seconds; shutting down" -- an Ansible-managed
    # /etc/jupyter/jupyter_server_config.py does, after 2 h), and nothing else would
    # bring it back: the card's link would point at a dead port for the rest of the
    # job. Relaunching on the same port, prefix and token keeps that link valid; the
    # user reloads the tab. Nothing is lost by it -- a notebook's kernel only relays
    # to the session, which is the control's and does not restart with the Lab.
    #
    # Not `exec`: this subshell is LAB_PID and has to outlive each Lab, and cleanup
    # signals it, not the Lab. The TERM trap passes the signal on, or the Lab would
    # be left running after the job's script exits.
    lab_child=""
    trap 'if [[ -n "${lab_child}" ]]; then kill "${lab_child}" 2>/dev/null || true; fi; exit 0' TERM INT
    lab_quick_exits=0
    while :; do
      lab_started=${SECONDS}
      "${jupyter_bin}" --no-browser \
        --ServerApp.ip=0.0.0.0 \
        --ServerApp.port="${jupyter_port}" --ServerApp.port_retries=0 \
        --ServerApp.base_url="${jupyter_prefix}" \
        --ServerApp.allow_remote_access=True \
        --ServerApp.root_dir="${HOME}" \
        --MultiKernelManager.default_kernel_name=biopb-session \
        "${lab_extra[@]}" &
      lab_child=$!
      wait "${lab_child}" || true
      lab_child=""
      # A Lab that dies at once (a bad option, the port taken) would otherwise be
      # relaunched forever; after three in a row it is not going to start.
      if (( SECONDS - lab_started < 30 )); then lab_quick_exits=$(( lab_quick_exits + 1 )); else lab_quick_exits=0; fi
      if (( lab_quick_exits >= 3 )); then
        echo "--- JupyterLab exited three times within 30 s of starting; not restarting it."
        exit 1
      fi
      echo "--- JupyterLab exited after $(( SECONDS - lab_started )) s; starting it again in 2 s ($(date '+%F %T'))"
      sleep 2
    done
  ) > "${STAGED_ROOT}/jupyter.log" 2>&1 &
  LAB_PID=$!

  lab_ready=0
  for attempt in $(seq 1 60); do
    if ! kill -0 "${LAB_PID}" 2>/dev/null; then
      break
    fi
    lab_code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 \
        -H "Authorization: token ${jupyter_token}" \
        "http://127.0.0.1:${jupyter_port}${jupyter_prefix}/api/status" 2>/dev/null || true)"
    if [[ "${lab_code}" == "200" ]]; then
      lab_ready=1
      break
    fi
    sleep 1
  done
  if [[ "${lab_ready}" == "1" ]]; then
    echo "JupyterLab is ready, published at ${jupyter_prefix}/"
  else
    echo "WARNING: JupyterLab did not come up; its output is in ${STAGED_ROOT}/jupyter.log" >&2
    tail -n 20 "${STAGED_ROOT}/jupyter.log" >&2 2>/dev/null || true
  fi
fi

wait "${CONTROL_PID}"
