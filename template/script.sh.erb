#!/usr/bin/env bash
#
# Launch the BioPB stack for one OnDemand session.
#
# `biopb control run` is the whole deployment in one foreground process: it
# serves the web UI, supervises the Arrow Flight data plane as a child, and
# reverse-proxies that child's HTTP sidecar under /data_plane. It is the ONLY
# component that serves the browser bundle — the tensor server's sidecar carries
# no static assets, and neither does the biopb-tensor-server container image,
# which is a headless Flight-only data plane. That is why this app runs the full
# stack from the shared home install rather than the .sif.

set -euo pipefail

STAGED_ROOT="${PWD}"
CONFIG_FILE="${STAGED_ROOT}/biopb.json"

# --- where the install lives ---------------------------------------------- #
#
# Resolved from the environment as the *launching user* has it, and resolved
# HERE, before the per-session XDG overrides below repoint the very variables
# this reads. A site that ships biopb as a module may well set XDG_DATA_HOME, and
# that has to keep pointing at the module's bundle.
#
# Both are overridable for the same reason: this branch needs an unreleased biopb
# (biopb/biopb#731), so the CLI and the bundle may come from a build tree rather
# than ~/.local — and they must come from the *same* tree.
BIOPB_BIN_DIR="${BIOPB_BIN_DIR:-${HOME}/.local/bin}"
WEBAPP_DIR="${BIOPB_WEBAPP_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/biopb/webapp}"
export PATH="${BIOPB_BIN_DIR}:${PATH}"

# --- the session's own XDG surface ---------------------------------------- #
#
# biopb honours exactly three XDG base dirs and resolves them at call time
# (`biopb/_locations.py`): config, state, data. Giving the session its own has
# two payoffs, and the second is what multi-user deployment needs:
#
#   1. Two concurrent sessions cannot collide — they would otherwise share one
#      ~/.local/state/biopb for logs, the pid file, the credential, the session
#      registry and the control's discovery record.
#   2. A session's behaviour stops depending on whatever is in the launching
#      user's home, and it writes nothing back there. One user's stale
#      ~/.config/biopb (a legacy biopb.toml, say) can no longer change how their
#      session behaves, and no user's leftover ~/.local/share/biopb/webapp can
#      shadow the bundle the site chose above.
#
# The site's explicit choices still win: every path this app actually depends on
# is passed on the command line (--config, --static-dir) or captured above,
# before these take effect. What the overrides neutralize is biopb's *implicit*
# fallbacks — which is the point.
export XDG_STATE_HOME="${STAGED_ROOT}/state"    # logs, pid, credential, sessions
export XDG_CONFIG_HOME="${STAGED_ROOT}/config"  # biopb.json, mcp-config.json
export XDG_DATA_HOME="${STAGED_ROOT}/data"      # webapp / samples lookups
mkdir -p "${XDG_STATE_HOME}" "${XDG_CONFIG_HOME}" "${XDG_DATA_HOME}"

# The transcode cache goes on node-local disk, not NFS home: it is written
# constantly, it is worthless after the job ends, and the file backend takes a
# cross-process lock that two sessions sharing a directory would contend on.
SESSION_TMP="${TMPDIR:-/tmp}/biopb-ood-${SLURM_JOB_ID:-$$}"
CACHE_DIR="${SESSION_TMP}/cache"
# biopb itself does not read XDG_CACHE_HOME — this is for the scientific stack
# underneath it (font/JIT/plugin caches), which otherwise lands in NFS home and
# is written by every concurrent session on the cluster at once.
export XDG_CACHE_HOME="${SESSION_TMP}/xdg-cache"
mkdir -p "${CACHE_DIR}" "${XDG_CACHE_HOME}"
cleanup () { rm -rf "${SESSION_TMP}" 2>/dev/null || true; }
trap cleanup EXIT

# Java is only needed for the Bio-Formats fallback readers (.zvi, .ims, .oif).
# Everything else is native Python, so a missing module is not fatal.
if command -v module >/dev/null 2>&1; then
  module load java/21.0.2 >/dev/null 2>&1 || true
fi

if ! command -v biopb >/dev/null 2>&1; then
  echo "ERROR: 'biopb' not found on PATH." >&2
  echo "Install it with:  curl -fsSL https://biopb.org/install.sh | bash" >&2
  exit 1
fi

if [[ ! -f "${WEBAPP_DIR}/index.html" ]]; then
  echo "ERROR: the web UI bundle is missing at ${WEBAPP_DIR}." >&2
  echo "Re-run the biopb installer to restore it." >&2
  exit 1
fi

# `server.port` is how the released control tells its data-plane child which
# Flight port to bind; newer builds pass it explicitly and ignore this. Setting
# it is correct either way.
cat > "${CONFIG_FILE}" <<JSON
{
  "server": {
    "host": "127.0.0.1",
    "port": ${grpc_port},
    "aggressive_dir_pruning": true
  },
  "cache": {
    "backend": "file",
    "file_cache_dir": "${CACHE_DIR}",
    "file_max_total_gb": <%= cache_gb %>
  },
  "sources": [
    {
      "url": "<%= user_data_dir %>",
      "monitor": <%= monitor_sources %>
    }
  ]
}
JSON

echo "BioPB session starting on $(hostname)"
echo "  data directory : <%= user_data_dir %>"
echo "  control (UI)   : 0.0.0.0:${control_port}  (portal proxy target)"
echo "  published at   : ${url_prefix}/"
echo "  HTTP sidecar   : 127.0.0.1:${sidecar_port}"
echo "  Arrow Flight   : 127.0.0.1:${grpc_port}"

# This branch serves the UI through OnDemand's proxy, which requires a biopb
# carrying --url-prefix (biopb/biopb#731). Without it the control emits a shell
# whose asset and API URLs are anchored at the *portal* root, so the page would
# load nothing behind the proxy — and it would fail as a blank screen rather than
# as an error. Refuse up front instead.
if ! biopb control run --help 2>/dev/null | grep -q -- '--url-prefix'; then
  echo "ERROR: this biopb install does not support --url-prefix." >&2
  echo "       The portal-proxied app needs biopb/biopb#731 (currently on the" >&2
  echo "       biopb dev branch, not in a release). Either upgrade biopb, or" >&2
  echo "       use the main branch of this app, which reaches the same stack" >&2
  echo "       over an SSH tunnel and works on 0.12.0." >&2
  exit 1
fi

# The OnDemand proxy runs on the portal's web node and connects to this compute
# node over the network, so the control cannot stay on loopback the way biopb's
# default assumes. BIOPB_CONTROL_HOST is biopb's documented escape hatch for the
# control bind (`_control_bind_endpoint`: "env still wins"). The access token
# gates it; the sidecar and the Flight plane are unaffected and stay on 127.0.0.1.
#
# The cost, stated plainly: portal -> compute node is plain HTTP, so the token
# crosses the cluster network in the clear (biopb/biopb#614 — the control has no
# TLS). Browser -> portal is HTTPS. This is the same posture as every OnDemand
# Jupyter app, and it is the reason the tunnel variant on `main` still exists.
export BIOPB_CONTROL_HOST=0.0.0.0
export BIOPB_TENSOR_TOKEN="${biopb_token}"

biopb control run \
  --config "${CONFIG_FILE}" \
  --static-dir "${WEBAPP_DIR}" \
  --base-port "${base_port}" \
  --grpc-bind 127.0.0.1 \
  --no-tls \
  --url-prefix "${url_prefix}" \
  --log-level INFO &
CONTROL_PID=$!

# Wait for the browser origin to be serving before declaring the session ready.
#
# The gate is HTTP 200 on /data_plane/readyz — the sidecar's health probe, which
# lives at the sidecar ROOT (not under /api/*) and reaches it through the
# control's prefix-stripping /data_plane mount. Do NOT gate on the control's own
# data_plane.state=="serving": that reflects a TCP probe of the Flight port,
# which comes up about two seconds before the sidecar binds, so the UI would
# still 502. Do not require the body's "ready":true either — the sidecar answers
# before it has connected to Flight, so it reports "degraded"/source_count 0 for
# a moment on a perfectly healthy start.
echo -n "Waiting for the data plane"
READY=0
for _ in $(seq 1 150); do
  if ! kill -0 "${CONTROL_PID}" 2>/dev/null; then
    echo
    echo "ERROR: the control plane exited during startup." >&2
    wait "${CONTROL_PID}" || true
    exit 1
  fi
  code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 \
      -H "Authorization: Bearer ${biopb_token}" \
      "http://127.0.0.1:${control_port}/data_plane/readyz" 2>/dev/null || true)"
  if [[ "${code}" == "200" ]]; then
    READY=1
    break
  fi
  sleep 2
  echo -n "."
done
echo

if [[ "${READY}" == "1" ]]; then
  # The readiness gate above probes the *unprefixed* path over loopback, which a
  # prefixed control still answers. That is not what the portal will ask for, so
  # confirm the published document once: the shell must come back carrying the
  # <base href> the SPA reads its prefix from. A 200 without it means the bundle
  # predates biopb/biopb#731 even though the CLI accepted the flag, which would
  # otherwise surface as a blank page with no explanation.
  shell="$(curl -s -m 5 "http://127.0.0.1:${control_port}${url_prefix}/" 2>/dev/null || true)"
  if grep -q "<base href=\"${url_prefix}/\">" <<<"${shell}"; then
    echo "BioPB is ready, published at ${url_prefix}/"
  else
    echo "WARNING: the control is up but the page served at ${url_prefix}/ carries" >&2
    echo "         no <base href>, so the browser will resolve its assets at the" >&2
    echo "         portal root and the UI will come up blank. The installed web" >&2
    echo "         bundle is probably older than the CLI — reinstall biopb so the" >&2
    echo "         two match." >&2
  fi
else
  echo "WARNING: the data plane did not report ready in time; leaving the" >&2
  echo "         session up anyway so you can inspect the log above." >&2
fi

wait "${CONTROL_PID}"
