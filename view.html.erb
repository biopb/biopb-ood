<%-
  user       = ood_user
  app_url    = "#{url_prefix}/?token=#{biopb_token}"
  # A login host is only needed to *reach* the compute node. Blank means either
  # the site's OnDemand config declares none or the user cleared it, so emit a
  # direct ssh rather than a `-J @` that cannot work.
  jump       = login_host.to_s.strip.empty? ? "" : "-J #{user}@#{login_host.strip} "
  flight_cmd = "ssh -N -L #{grpc_port}:127.0.0.1:#{grpc_port} #{jump}#{user}@#{host}"
  uid        = "biopb-#{port}"
-%>

<div style="margin-bottom:14px">
  <a href="<%= app_url %>" target="_blank" rel="noopener"
     class="btn btn-primary btn-lg">
    <i class="fa fa-microscope"></i> Connect to BioPB
  </a>
  <p class="help-block" style="margin-top:8px">
    The link carries your access token; the app stores it and strips it from the
    address bar. If the catalog looks empty at first, the data plane is still
    indexing — it fills in as it scans.
  </p>
</div>

<table class="table table-condensed" style="margin-bottom:0">
  <tbody>
    <tr>
      <th style="width:11em;border-top:none">Data directory</th>
      <td style="border-top:none"><code><%= data_dir %></code></td>
    </tr>
    <tr>
      <th>Compute node</th>
      <td><code><%= host %></code></td>
    </tr>
    <tr>
      <th>Arrow Flight</th>
      <td>
        <code>grpc://127.0.0.1:<%= grpc_port %></code>
        <p class="help-block" style="margin:4px 0 6px">
          For the Python/Java SDK or napari. Unlike the web UI, this one is not
          published through the portal — it stays on the node's loopback, so it
          needs an SSH tunnel. Run this on your own computer and leave it going:
        </p>
        <div class="input-group">
          <input type="text" readonly class="form-control" id="<%= uid %>-flight"
                 style="font-family:monospace;font-size:12px"
                 value="<%= flight_cmd %>">
          <span class="input-group-btn">
            <button class="btn btn-default" type="button"
                    onclick="biopbCopy('<%= uid %>-flight', this)">
              <i class="fa fa-clipboard"></i> Copy
            </button>
          </span>
        </div>
        <p class="help-block" style="margin-top:4px">
          Then connect to <code>grpc://localhost:<%= grpc_port %></code> with the
          token from the link above.
          <%- if jump.empty? -%>
          If <code><%= host %></code> is not reachable from your machine, hop
          through your login host by adding
          <code>-J <%= user %>@&lt;login-host&gt;</code> — or set one in the
          launch form and it will be filled in here.
          <%- end -%>
        </p>
      </td>
    </tr>
  </tbody>
</table>

<script>
  function biopbCopy(id, btn) {
    var el = document.getElementById(id);
    var done = function () {
      var old = btn.innerHTML;
      btn.innerHTML = '<i class="fa fa-check"></i> Copied';
      setTimeout(function () { btn.innerHTML = old; }, 1500);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(el.value).then(done);
    } else {
      // Fallback for a non-HTTPS portal, where the async clipboard API is absent.
      var tmp = document.createElement("textarea");
      tmp.value = el.value;
      tmp.style.position = "fixed";
      tmp.style.opacity = "0";
      document.body.appendChild(tmp);
      tmp.select();
      try { document.execCommand("copy"); done(); } catch (e) { /* leave as-is */ }
      document.body.removeChild(tmp);
    }
  }
</script>
