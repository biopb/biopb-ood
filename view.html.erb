<%-
  user       = ood_user
  # Land on the control dashboard, which shows the server's state and links on to
  # the apps (data browser, viewer).
  app_url    = "#{url_prefix}/?token=#{biopb_token}"
  # A login host is only needed to *reach* the compute node. Blank means either
  # the site's OnDemand config declares none or the user cleared it, so emit a
  # direct ssh rather than a `-J @` that cannot work.
  jump       = login_host.to_s.strip.empty? ? "" : "-J #{user}@#{login_host.strip} "
  flight_cmd = "ssh -N -L #{grpc_port}:127.0.0.1:#{grpc_port} #{jump}#{user}@#{host}"
  uid        = "biopb-#{port}"
  # What the launcher actually did, not what the form asked: before.sh.erb
  # downgrades to loopback if it could not produce a certificate. flight_url
  # itself comes from before.sh.erb via connection.yml (submit.yml.erb), so
  # this card and --grpc-external-location always agree on the same string.
  remote     = flight_remote.to_s == "true"
  # Same rule: what before.sh.erb arranged (it found a JupyterLab), not what the
  # form asked. `jupyter_requested` without `jupyter_enabled` is the notice below.
  lab        = jupyter_enabled.to_s == "true"
  lab_wanted = jupyter_requested.to_s == "true"
  lab_url    = "#{jupyter_prefix}/lab?token=#{jupyter_token}"
-%>

<div style="margin-bottom:14px">
  <a href="<%= app_url %>" target="_blank" rel="noopener"
     class="btn btn-primary btn-lg" style="min-width:18em;text-align:left">
    <i class="fa fa-microscope fa-fw"></i> Connect to BioPB
  </a>
  <p class="help-block" style="margin-top:8px">
    The BioPB dashboard: shows the server status and links to the apps, such as
    the data browser. Use this button rather than typing the address; it carries
    your access token.
  </p>
</div>

<%- if lab -%>
<div style="margin-bottom:14px">
  <a href="<%= lab_url %>" target="_blank" rel="noopener"
     class="btn btn-default btn-lg" style="min-width:18em;text-align:left">
    <i class="fa fa-terminal fa-fw"></i> Open JupyterLab
  </a>
  <p class="help-block" style="margin-top:8px">
    Notebooks and a terminal on the compute node. JupyterLab starts after BioPB
    and can take a few minutes; until then this button shows a connection error.
    In a notebook, pick the kernel <em>"biopb: connect to the running biopb
    session"</em>; in the terminal, attach an AI agent with
    <code>claude mcp add --transport http biopb-session "$BIOPB_MCP_URL"</code>
    (any agent takes that address as an HTTP MCP server).
  </p>
</div>
<%- elsif lab_wanted -%>
<div class="alert alert-warning" style="margin-bottom:14px">
  <strong>JupyterLab was requested, but none was found on this node.</strong>
  The viewer is unaffected. Ask your site to put <code>jupyter-lab</code> on the
  node's PATH, or see <em>Installing JupyterLab</em> in the app's INSTALL.md.
</div>
<%- end -%>

<%# OnDemand's own shell app, for a terminal that does not depend on JupyterLab
    (which may have none, or none the site allows). It is the portal's terminal,
    so the site's policy governs it: whether it will open a compute node at all is
    the site's host allowlist, not something this app can see or change. -%>
<div style="margin-bottom:14px">
  <a href="/pun/sys/shell/ssh/<%= host %>" target="_blank" rel="noopener"
     class="btn btn-default btn-lg" style="min-width:18em;text-align:left">
    <i class="fa fa-terminal fa-fw"></i> Open Shell
  </a>
  <p class="help-block" style="margin-top:8px">
    OnDemand's own shell on <code><%= host %></code>, for running an AI agent next
    to this session. If the portal refuses the host, your site does not allow
    shells on compute nodes; use <code>ssh <%= host %></code> instead.
  </p>
</div>

<table class="table table-condensed" style="margin-bottom:0">
  <tbody>
    <tr>
      <th style="width:11em;border-top:none">Data directory</th>
      <td style="border-top:none"><code><%= data_dir %></code></td>
    </tr>
    <tr>
      <th>Compute node</th>
      <td><code><%= host %></code></td>
    </tr>
    <tr>
      <th>Access token</th>
      <td>
        <div class="input-group">
          <input type="text" readonly class="form-control" id="<%= uid %>-token"
                 style="font-family:monospace;font-size:12px"
                 value="<%= biopb_token %>">
          <span class="input-group-btn">
            <button class="btn btn-default" type="button"
                    onclick="biopbCopy('<%= uid %>-token', this)">
              <i class="fa fa-clipboard"></i> Copy
            </button>
          </span>
        </div>
        <p class="help-block" style="margin-top:4px">
          The Connect button already carries this, so you only need it for an SDK
          or napari client. It stays the same when you relaunch, so a copy saved
          in a script keeps working. It gates the data <em>and</em> the admin API
          — treat it as a password, and rotate it by deleting
          <code>~/.local/state/biopb-ood/token</code>.
        </p>
      </td>
    </tr>
    <tr>
      <th>Arrow Flight</th>
      <td>
        <div class="input-group">
          <input type="text" readonly class="form-control" id="<%= uid %>-flighturl"
                 style="font-family:monospace;font-size:12px" value="<%= flight_url %>">
          <span class="input-group-btn">
            <button class="btn btn-default" type="button"
                    onclick="biopbCopy('<%= uid %>-flighturl', this)">
              <i class="fa fa-clipboard"></i> Copy
            </button>
          </span>
        </div>

        <%- if remote -%>
        <p class="help-block" style="margin-top:6px">
          For the Python/Java SDK or napari. This one is published on the node
          directly rather than through the portal, so there is no tunnel to keep
          running — but it is only reachable from inside the campus network.
          Connect with the access token above.
        </p>
        <%- if flight_fingerprint.to_s.strip.empty? -%>
        <p class="help-block">
          The connection is TLS, and your client pins the certificate the first
          time it connects. That certificate belongs to your account alone, and
          it is reused for every session on every node, so the pin keeps working
          after a relaunch.
        </p>
        <%- else -%>
        <p class="help-block" style="margin-bottom:4px">
          <strong>Certificate fingerprint (SHA-256).</strong> The certificate is
          self-signed, so your client trusts it by pinning it on first connect.
          Check this value the first time — reading it here, over the portal's
          authenticated HTTPS, is what makes that first connection trustworthy
          rather than merely convenient. It is your account's own certificate and
          is reused on every node, so the pin survives relaunches.
        </p>
        <div class="input-group">
          <input type="text" readonly class="form-control" id="<%= uid %>-fp"
                 style="font-family:monospace;font-size:11px"
                 value="<%= flight_fingerprint %>">
          <span class="input-group-btn">
            <button class="btn btn-default" type="button"
                    onclick="biopbCopy('<%= uid %>-fp', this)">
              <i class="fa fa-clipboard"></i> Copy
            </button>
          </span>
        </div>
        <p class="help-block" style="margin-top:6px">
          Passing it explicitly turns first-use trust into a verified
          connection:<br>
          <code style="font-size:11px">TensorClient("<%= flight_url %>", token=…, tls_fingerprint="<%= flight_fingerprint %>")</code>
        </p>
        <%- end -%>
        <%- else -%>
        <p class="help-block" style="margin:6px 0">
          For the Python/Java SDK or napari. This session keeps Flight on the
          node's loopback, so it needs an SSH tunnel. Run this on your own
          computer and leave it going:
        </p>
        <div class="input-group">
          <input type="text" readonly class="form-control" id="<%= uid %>-flight"
                 style="font-family:monospace;font-size:12px"
                 value="<%= flight_cmd %>">
          <span class="input-group-btn">
            <button class="btn btn-default" type="button"
                    onclick="biopbCopy('<%= uid %>-flight', this)">
              <i class="fa fa-clipboard"></i> Copy
            </button>
          </span>
        </div>
        <p class="help-block" style="margin-top:4px">
          Then connect to <code><%= flight_url %></code> with the token above.
          <%- if jump.empty? -%>
          If <code><%= host %></code> is not reachable from your machine, hop
          through your login host by adding
          <code>-J <%= user %>@&lt;login-host&gt;</code> — or set one in the
          launch form and it will be filled in here.
          <%- end -%>
          Relaunch with <em>Arrow Flight access</em> set to remote to skip the
          tunnel entirely.
        </p>
        <%- end -%>
      </td>
    </tr>
  </tbody>
</table>

<script>
  function biopbCopy(id, btn) {
    var el = document.getElementById(id);
    var done = function () {
      var old = btn.innerHTML;
      btn.innerHTML = '<i class="fa fa-check"></i> Copied';
      setTimeout(function () { btn.innerHTML = old; }, 1500);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(el.value).then(done);
    } else {
      // Fallback for a non-HTTPS portal, where the async clipboard API is absent.
      var tmp = document.createElement("textarea");
      tmp.value = el.value;
      tmp.style.position = "fixed";
      tmp.style.opacity = "0";
      document.body.appendChild(tmp);
      tmp.select();
      try { document.execCommand("copy"); done(); } catch (e) { /* leave as-is */ }
      document.body.removeChild(tmp);
    }
  }
</script>
